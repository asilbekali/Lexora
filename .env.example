# ---------------------------------------------------------------------------
# Lexora — copy this file to `.env` and fill in your own values.
# `.env` and `.env.local` are gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# API server port (Vite proxies /api here during development).
PORT=8787

# --- Authentication --------------------------------------------------------
# The single administrator account.
ADMIN_USERNAME=asilbek

# For local development you may set a plaintext password; the server hashes it
# with scrypt at boot and never stores it in plaintext.
ADMIN_PASSWORD=asi_2007

# Preferred (and required in production): a pre-computed scrypt hash.
# Generate one with:  npm run hash-password -- 'your-password'
# When set, this wins over ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=scrypt$...$...

# Signs the session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE_HOURS=12

# --- AI provider (Google Gemini) --------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to run in offline mode: the app still works, it
# just fills new words from the built-in dictionary instead of the AI.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Free-tier request caps are per model per day, so switching model gives a
# fresh allowance. Lite models are fastest and cheapest for short lookups.
GEMINI_MODEL=gemini-3.5-flash-lite
# "low" skips the thinking budget — right for short lookups, and much cheaper.
GEMINI_THINKING_LEVEL=low
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# --- Flashcard images (free, no key needed) --------------------------------
# Illustrations come from Openverse (Creative Commons) with Wikimedia Commons
# as a fallback. Only licences allowing commercial use are requested.
IMAGES_ENABLED=true
IMAGES_TIMEOUT_MS=8000

# --- Storage ---------------------------------------------------------------
# All vocabulary lives in this JSON file.
DATA_FILE=server/data/db.json
ARCHIVE_DIR=server/data/archive

# The store is automatically cleared every AUTO_RESET_DAYS days.
# A timestamped copy is written to ARCHIVE_DIR first unless disabled.
AUTO_RESET_ENABLED=true
AUTO_RESET_DAYS=30
AUTO_RESET_ARCHIVE=true
